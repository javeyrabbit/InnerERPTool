<Application x:Class="PLErpTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PLErpTool.Converters"
             xmlns:vm="clr-namespace:PLErpTool.ViewModels"
             xmlns:v="clr-namespace:PLErpTool.Views.Receivable"
             xmlns:va="clr-namespace:PLErpTool.Views.Account"
             xmlns:vp="clr-namespace:PLErpTool.Views.Personnel"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/VioletTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
            <DataTemplate DataType="{x:Type vm:ReceivableViewModel}">
                <v:ReceivableView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                <va:AccountView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PersonnelViewModel}">
                <vp:PersonnelView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
