<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:PLErpTool.Converters">
    <converters:BalanceColorConverter x:Key="BalanceColorConverter"/>

    <Color x:Key="PrimaryColor">#5448C8</Color>
    <Color x:Key="PrimaryDarkColor">#4237A0</Color>
    <Color x:Key="MenuBgColor">#302E5B</Color>
    <Color x:Key="SidebarBgColor">#FAF9FF</Color>
    <Color x:Key="RowAltColor">#F7F6FC</Color>
    <Color x:Key="RowHoverColor">#F0EFFA</Color>
    <Color x:Key="NegativeColor">#FF4D4F</Color>
    <Color x:Key="PositiveColor">#107C41</Color>
    <Color x:Key="BorderColor">#E8E6F5</Color>
    <Color x:Key="TerminalBgColor">#1E1B2E</Color>
    <Color x:Key="TerminalFgColor">#D4D4D4</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="MenuBgBrush" Color="{StaticResource MenuBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}"/>
    <SolidColorBrush x:Key="ExportBrush" Color="{StaticResource PositiveColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource NegativeColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TerminalBgBrush" Color="{StaticResource TerminalBgColor}"/>
    <SolidColorBrush x:Key="TerminalFgBrush" Color="{StaticResource TerminalFgColor}"/>
    <SolidColorBrush x:Key="MenuTextBrush" Color="#B5B5C3"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666"/>

    <!-- WPF UI navigation resources: retain the existing violet navigation palette. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#302E5B" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#C8C4DE" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="White" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="#C8C4DE" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="White" />
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#3D3A73" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#5B46D7" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="#5B46D7" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#4237A0" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#A8A8FC" />
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#4B497D" />

    <FontFamily x:Key="AppFont">Microsoft YaHei</FontFamily>
    <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
    <Geometry x:Key="DocumentIcon">M6,2 L14,2 L19,7 L19,22 L6,22 Z M14,2 L14,7 L19,7 M9,11 L16,11 M9,15 L16,15 M9,19 L14,19</Geometry>
    <Geometry x:Key="DatabaseIcon">M4,6 C4,3.8 7.6,2 12,2 C16.4,2 20,3.8 20,6 L20,18 C20,20.2 16.4,22 12,22 C7.6,22 4,20.2 4,18 Z M4,6 C4,8.2 7.6,10 12,10 C16.4,10 20,8.2 20,6 M4,12 C4,14.2 7.6,16 12,16 C16.4,16 20,14.2 20,12</Geometry>
    <Geometry x:Key="ListIcon">M5,6 L20,6 M5,12 L20,12 M5,18 L20,18 M2,6 L2.01,6 M2,12 L2.01,12 M2,18 L2.01,18</Geometry>
    <Geometry x:Key="SearchIcon">M10.5,3 A7.5,7.5 0 1 1 10.5,18 A7.5,7.5 0 1 1 10.5,3 M16,16 L22,22</Geometry>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Border" Property="Background" Value="#F4F2FF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="Text" Value="{x:Null}"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageBtnStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="#EEEAF8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.06" Color="#5448C8"/></Setter.Value></Setter>
    </Style>

</ResourceDictionary>
