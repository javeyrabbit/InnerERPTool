<UserControl x:Class="PLErpTool.Views.Receivable.ReceivableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧侧边栏 (树状结构检索)  -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border Padding="5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#555"
                                       Text="客户" />
                            <ComboBox x:Name="TreeCustomerSearchBox"
                                      Grid.Column="1"
                                      Padding="6,0"
                                      Height="32"
                                      ToolTip="输入客户名称筛选（支持历史记录）"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding TreeCustomerSuggestions}"
                                      Loaded="SearchComboBox_Loaded"
                                      PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                      LostKeyboardFocus="TreeSearchComboBox_LostKeyboardFocus"
                                      StaysOpenOnEdit="True"
                                      MaxDropDownHeight="260"
                                      VerticalContentAlignment="Center"
                                      Text="{Binding TreeCustomerKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#555"
                                       Text="业务员" />
                            <ComboBox x:Name="TreeSalesmanSearchBox"
                                      Grid.Column="1"
                                      Padding="6,0"
                                      Height="32"
                                      ToolTip="输入业务员名称筛选（支持历史记录）"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding TreeSalesmanSuggestions}"
                                      Loaded="SearchComboBox_Loaded"
                                      PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                      LostKeyboardFocus="TreeSearchComboBox_LostKeyboardFocus"
                                      StaysOpenOnEdit="True"
                                      MaxDropDownHeight="260"
                                      VerticalContentAlignment="Center"
                                      Text="{Binding TreeSalesmanKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12,10,15">
                        <Button Margin="0,0,0,6"
                                Padding="6,8"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding LoadAllCommand}"
                                Content="全部"
                                Cursor="Hand"
                                FontSize="15"
                                FontWeight="Bold"
                                Tag="{Binding AllMenuTag}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Path Data="{StaticResource ListIcon}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" />
                                            </Viewbox>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F4F2FF" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="Border" Property="Background" Value="#EBE8FF" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TreeView x:Name="CustomerTreeView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemsSource="{Binding CustomerTree}"
                                  PreviewMouseWheel="CustomerTreeView_PreviewMouseWheel"
                                  SelectedItemChanged="OnTreeSelected">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander"
                                                                  Grid.Row="0"
                                                                  Grid.Column="0"
                                                                  Width="18"
                                                                  Height="32"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <Path x:Name="Arrow"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="M0,0 L6,5 L0,10 Z"
                                                              Fill="#666" />
                                                    </ToggleButton>
                                                    <Border x:Name="Header"
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Padding="6,7"
                                                            CornerRadius="4">
                                                        <ContentPresenter ContentSource="Header" />
                                                    </Border>
                                                    <ItemsPresenter x:Name="ItemsHost"
                                                                    Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    Margin="15,0,0,0" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Header" Property="Background" Value="#F4F2FF" />
                                                    </Trigger>
                                                    <Trigger SourceName="Expander" Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" CenterX="3" CenterY="5" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock FontSize="14" Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555555" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompany}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="#2C3E50" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  右侧主内容区  -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部搜索过滤栏  -->
            <Border Grid.Row="0"
                    Background="White"
                    Padding="0,10,0,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="5,0">
                    <ScrollViewer Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <WrapPanel VerticalAlignment="Center">
                            <!--  1. 客户搜索组  -->
                            <StackPanel Margin="0,8,16,8" Orientation="Horizontal">
                                <TextBlock Margin="0,2,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#555"
                                           Text="客户" />
                                <ComboBox Width="160"
                                          Height="32"
                                          Padding="6,0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          ItemsSource="{Binding CustomerSuggestions}"
                                          Loaded="SearchComboBox_Loaded"
                                          PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                          StaysOpenOnEdit="True"
                                          VerticalContentAlignment="Center"
                                          Text="{Binding SearchCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  2. 业务员搜索组  -->
                            <StackPanel Margin="0,8,16,8" Orientation="Horizontal">
                                <TextBlock Margin="0,2,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#555"
                                           Text="业务员" />
                                <ComboBox Width="140"
                                          Height="32"
                                          Padding="6,0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          ItemsSource="{Binding SalesmanSuggestions}"
                                          Loaded="SearchComboBox_Loaded"
                                          PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                          StaysOpenOnEdit="True"
                                          VerticalContentAlignment="Center"
                                          Text="{Binding SearchSalesman, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  3. 账期选择组  -->
                            <StackPanel Margin="0,8,16,8" Orientation="Horizontal">
                                <TextBlock Margin="0,2,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#555"
                                           Text="账期" />
                                <DatePicker Width="132"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Language="zh-CN"
                                            SelectedDateFormat="Short"
                                            SelectedDate="{Binding StartMonthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="8,2,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="#999"
                                           Text="至" />
                                <DatePicker Width="132"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Language="zh-CN"
                                            SelectedDateFormat="Short"
                                            SelectedDate="{Binding EndMonthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  4. 其他操作  -->
                            <CheckBox Margin="0,8,16,8"
                                      VerticalAlignment="Center"
                                      Content="当前差额为负"
                                      FontSize="13"
                                      Foreground="#555"
                                      IsChecked="{Binding NegativeBalanceOnly}" />
                            <ui:Button Height="32"
                                    Margin="0,8,8,8"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding SearchCommand}"
                                    Content="查询"
                                    Appearance="Primary" />
                            <ui:Button Height="32"
                                    Margin="0,8,16,8"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ResetSearchCommand}"
                                    Content="重置条件"
                                    Appearance="Secondary" />
                            <ui:Button Height="32"
                                    Margin="0,8,8,8"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ExportCommand}"
                                    Content="导出Excel明细"
                                    Appearance="Secondary" />
                            <ui:Button Height="32"
                                    Margin="0,8,0,8"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenNewMonthCommand}"
                                    Content="＋ 新增月份欠款"
                                    FontSize="14"
                                    Appearance="Primary" />
                        </WrapPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  主数据列表区  -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="0,0,0,10"
                        Background="White">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="#555"
                                   Text="{Binding TotalDebtTitle}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#E53935"
                                   Text="{Binding TotalDebtAmount, StringFormat={}{0:N2} 元}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,1,1,0">
                    <DataGrid x:Name="ReceivableDataGrid"
                              AlternationCount="2"
                              AutoGenerateColumns="False"
                              Background="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              ColumnHeaderHeight="40"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding Debts}"
                              RowDetailsVisibilityMode="Collapsed"
                              RowHeight="40"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="ColumnWidth" Value="*" />
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Resources>
                            <Style x:Key="CenteredGridTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Padding" Value="15,0" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#444444" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#F0F0F0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource RowAltBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!--  ========= 核心修改：分离式子表模板（固定右侧多列） =========  -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      HorizontalAlignment="Left"
                                      ClipToBounds="True"
                                      Background="{StaticResource RowAltBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  子表包裹容器  -->
                                    <Border Grid.Column="1"
                                            Margin="0,8,8,8"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                        <TabControl BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch">
                                            <TabControl.Template>
                                                <ControlTemplate TargetType="{x:Type TabControl}">
                                                    <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <UniformGrid Grid.Row="0"
                                                                     Rows="1"
                                                                     IsItemsHost="True"
                                                                     KeyboardNavigation.TabIndex="1" />
                                                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                                                          Grid.Row="1"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Stretch"
                                                                          ContentSource="SelectedContent"
                                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </TabControl.Template>
                                            <TabControl.ItemContainerStyle>
                                                <Style TargetType="{x:Type TabItem}">
                                                    <Setter Property="Height" Value="34" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="#F5F5F5" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                    <Setter Property="Foreground" Value="#333333" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type TabItem}">
                                                                <Border x:Name="TabBorder"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                      ContentSource="Header" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="TabBorder" Property="Background" Value="#EEEAFE" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TabControl.ItemContainerStyle>
                                            <TabItem Header="欠款">
                                                <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <!--  品名筛选区  -->
                                                <RowDefinition Height="*" />
                                                <!--  数据展示区  -->
                                                <RowDefinition Height="Auto" />
                                                <!--  子表分页区  -->
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Padding="12,7"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Height="44"
                                                              VerticalAlignment="Top">
                                                    <StackPanel Height="28" Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666"
                                                               Text="品名" />
                                                    <ComboBox Width="240"
                                                              Height="28"
                                                              Padding="6,0"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Center"
                                                              FlowDirection="LeftToRight"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              ItemsSource="{Binding DebtProductSuggestions}"
                                                              MaxDropDownHeight="220"
                                                              Loaded="SearchComboBox_Loaded"
                                                              PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                                              SelectionChanged="DebtProductFilter_SelectionChanged"
                                                              StaysOpenOnEdit="True"
                                                              Text="{Binding DebtProductKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Margin="16,0,8,0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666"
                                                               Text="客户物料" />
                                                    <ComboBox Width="240"
                                                              Height="28"
                                                              Padding="6,0"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Center"
                                                              FlowDirection="LeftToRight"
                                                              IsEditable="True"
                                                              IsEnabled="{Binding HasDebtProductFilter}"
                                                              IsTextSearchEnabled="False"
                                                              ItemsSource="{Binding CustomerMaterialSuggestions}"
                                                              MaxDropDownHeight="220"
                                                              Loaded="SearchComboBox_Loaded"
                                                              PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                                              SelectionChanged="CustomerMaterialFilter_SelectionChanged"
                                                              StaysOpenOnEdit="True"
                                                              ToolTip="请先选择品名，再选择客户物料"
                                                              Text="{Binding CustomerMaterialKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Margin="16,0,8,0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666"
                                                               Text="欠款类型" />
                                                    <ComboBox Width="120"
                                                              Height="28"
                                                              Padding="6,0"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Center"
                                                              FlowDirection="LeftToRight"
                                                              ItemsSource="{Binding DebtTypeOptions}"
                                                              SelectionChanged="DebtTypeFilter_SelectionChanged"
                                                              SelectedItem="{Binding DebtTypeKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="10,0,0,0"
                                                            Padding="12,4"
                                                            Command="{Binding ClearDebtProductFilterCommand}"
                                                            Content="清空条件"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  === 上半部分：数据区 ===  -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <!--  右侧固定区域：数量、单价、金额、操作  -->
                                                    <ColumnDefinition Width="545" />
                                                </Grid.ColumnDefinitions>

                                                <!--  === 左侧滑动区域 ===  -->
                                                <ScrollViewer Grid.Column="0"
                                                              BorderThickness="0"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              PreviewMouseWheel="SubTable_PreviewMouseWheel"
                                                              VerticalScrollBarVisibility="Disabled">
                                                    <StackPanel Grid.IsSharedSizeScope="True">
                                                        <!--  左侧数据头  -->
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid Height="36" Background="#F8F9FA">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtDateColumn" />
                                                                    <!--  登记日期  -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtDocumentColumn" />
                                                                    <!--  单据号码  -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtProductColumn" />
                                                                    <!--  品名  -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtTypeColumn" />
                                                                    <!--  欠款类型  -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtSpecColumn" />
                                                                    <!--  头+牙+锁+管长+大管+长心  -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DebtMaterialColumn" />
                                                                    <!--  客户物料  -->
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="登记日期" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="单据号码" />
                                                                <TextBlock Grid.Column="2"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="品名" />
                                                                <TextBlock Grid.Column="3"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="欠款类型" />
                                                                <TextBlock Grid.Column="4"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="头+牙+锁+管长+大管+长心" />
                                                                <TextBlock Grid.Column="5"
                                                                           Margin="6,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#666"
                                                                           Style="{StaticResource CenteredGridTextStyle}"
                                                                           Text="客户物料" />
                                                            </Grid>
                                                        </Border>

                                                        <!--  左侧数据行  -->
                                                        <ItemsControl ItemsSource="{Binding DebtPayments}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                                                        <Grid Height="40">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtDateColumn" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtDocumentColumn" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtProductColumn" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtTypeColumn" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtSpecColumn" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DebtMaterialColumn" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding TradeDate, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding DocumentNo}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding ProductName}"
                                                                                       ToolTip="{Binding ProductName}" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding DisplayDebtType}" />
                                                                            <TextBlock Grid.Column="4"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding SpecDetails}"
                                                                                       ToolTip="{Binding SpecDetails}" />
                                                                            <TextBlock Grid.Column="5"
                                                                                       Margin="6,0"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding CustomerMaterial}"
                                                                                       ToolTip="{Binding CustomerMaterial}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  === 右侧固定操作与金额区域 ===  -->
                                                <StackPanel Grid.Column="1">
                                                    <!--  右侧表头  -->
                                                    <Border Height="36"
                                                            Background="#F8F9FA"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <!--  对账备注  -->
                                                                <ColumnDefinition Width="80" />
                                                                <!--  数量  -->
                                                                <ColumnDefinition Width="80" />
                                                                <!--  单价  -->
                                                                <ColumnDefinition Width="100" />
                                                                <!--  金额  -->
                                                                <ColumnDefinition Width="65" />
                                                                <!--  操作  -->
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#666"
                                                                       Text="对账备注" />
                                                            <TextBlock Grid.Column="1"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#666"
                                                                       Text="数量" />
                                                            <TextBlock Grid.Column="2"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#666"
                                                                       Text="单价" />
                                                            <TextBlock Grid.Column="3"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#666"
                                                                       Text="金额" />
                                                            <TextBlock Grid.Column="4"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#666"
                                                                       Text="操作" />
                                                        </Grid>
                                                    </Border>
                                                    <!--  右侧数据列 (高度=40 严格对齐)  -->
                                                    <ItemsControl ItemsSource="{Binding DebtPayments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Height="40"
                                                                        Background="White"
                                                                        BorderBrush="#EEE"
                                                                        BorderThickness="1,0,0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="220" />
                                                                            <ColumnDefinition Width="80" />
                                                                            <ColumnDefinition Width="80" />
                                                                            <ColumnDefinition Width="100" />
                                                                            <ColumnDefinition Width="65" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBox Grid.Column="0"
                                                                                 Margin="5,6"
                                                                                 Padding="4,2"
                                                                                 VerticalContentAlignment="Center"
                                                                                 BorderBrush="#CCC"
                                                                                 LostFocus="ReconciliationRemark_LostFocus"
                                                                                 Text="{Binding ReconciliationRemark, UpdateSourceTrigger=LostFocus}" />

                                                                        <!--  数量区  -->
                                                                        <Grid Grid.Column="1">
                                                                            <TextBlock HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding Quantity}"
                                                                                       Visibility="{Binding IsEditableQtyPrice, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                                            <TextBox Margin="4,6"
                                                                                     Padding="2"
                                                                                     HorizontalContentAlignment="Center"
                                                                                     VerticalContentAlignment="Center"
                                                                                     BorderBrush="#CCC"
                                                                                     LostFocus="SubItem_ValueChanged"
                                                                                     Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}"
                                                                                     Visibility="{Binding IsEditableQtyPrice, Converter={StaticResource BoolToVisConverter}}" />
                                                                        </Grid>

                                                                        <!--  单价区  -->
                                                                        <Grid Grid.Column="2">
                                                                            <TextBlock HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       Foreground="#444"
                                                                                       Text="{Binding UnitPrice}"
                                                                                       Visibility="{Binding IsEditableQtyPrice, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                                            <TextBox Margin="4,6"
                                                                                     Padding="2"
                                                                                     HorizontalContentAlignment="Center"
                                                                                     VerticalContentAlignment="Center"
                                                                                     BorderBrush="#CCC"
                                                                                     LostFocus="SubItem_ValueChanged"
                                                                                     Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus}"
                                                                                     Visibility="{Binding IsEditableQtyPrice, Converter={StaticResource BoolToVisConverter}}" />
                                                                        </Grid>

                                                                        <!--  金额区  -->
                                                                        <Grid Grid.Column="3">
                                                                            <TextBlock HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Text="{Binding Amount, StringFormat={}{0:N2}}"
                                                                                       Visibility="{Binding IsEditableAmount, Converter={StaticResource InverseBoolToVisConverter}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#444" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Type}" Value="欠款">
                                                                                                <Setter Property="Foreground" Value="#FF4D4F" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBox Margin="4,6"
                                                                                     Padding="2"
                                                                                     HorizontalContentAlignment="Center"
                                                                                     VerticalContentAlignment="Center"
                                                                                     BorderBrush="#CCC"
                                                                                     LostFocus="SubItem_ValueChanged"
                                                                                     Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                                                                                     Visibility="{Binding IsEditableAmount, Converter={StaticResource BoolToVisConverter}}" />
                                                                        </Grid>

                                                                        <!--  操作 (删除按钮)  -->
                                                                        <Button Grid.Column="4"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Command="{Binding DataContext.DeleteSubItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="删除"
                                                                                Cursor="Hand"
                                                                                FontSize="12"
                                                                                Foreground="#FF4D4F" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>

                                            <!--  === 下半部分：子表分页区 ===  -->
                                            <Border Grid.Row="2"
                                                    Padding="12,8"
                                                    Background="#F8F9FA"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    CornerRadius="0,0,4,4">
                                                <DockPanel>
                                                    <TextBlock VerticalAlignment="Center"
                                                               DockPanel.Dock="Left"
                                                               FontSize="12"
                                                               Foreground="#888">
                                                        <Run Text="共 " />
                                                        <Run Text="{Binding DebtTotalCount, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" />
                                                        <Run Text=" 条，每页展示 10 条" />
                                                    </TextBlock>

                                                    <StackPanel HorizontalAlignment="Right"
                                                                DockPanel.Dock="Right"
                                                                Orientation="Horizontal">
                                                        <Button Margin="0,0,10,0"
                                                                Command="{Binding DebtPrevPageCommand}"
                                                                Content="上一页"
                                                                IsEnabled="{Binding HasDebtPrevPage}"
                                                                Style="{StaticResource PageBtnStyle}" />

                                                        <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding DebtPageNumbers}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.DebtGoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Page}"
                                                                            Content="{Binding Label}">
                                                                        <Button.Style>
                                                                            <Style BasedOn="{StaticResource PageBtnStyle}" TargetType="Button">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Page}" Value="0">
                                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                                        <Setter Property="Background" Value="Transparent" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Command="{Binding DebtNextPageCommand}"
                                                                Content="下一页"
                                                                IsEnabled="{Binding HasDebtNextPage}"
                                                                Style="{StaticResource PageBtnStyle}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                                </Grid>
                                            </TabItem>

                                            <TabItem Header="收款">
                                                <Grid MinHeight="120">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <DataGrid Grid.Row="0"
                                                              AutoGenerateColumns="False"
                                                              BorderThickness="0"
                                                              CanUserAddRows="False"
                                                              ColumnHeaderHeight="36"
                                                              GridLinesVisibility="Horizontal"
                                                              HeadersVisibility="Column"
                                                              HorizontalGridLinesBrush="#EEEEEE"
                                                              IsReadOnly="False"
                                                              ItemsSource="{Binding CollectionPayments}"
                                                              PreviewMouseWheel="SubTable_PreviewMouseWheel"
                                                              RowHeight="40"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader">
                                                                <Setter Property="Background" Value="#F8F9FA" />
                                                                <Setter Property="Foreground" Value="#666" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>
                                                        <DataGrid.CellStyle>
                                                            <Style TargetType="DataGridCell">
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Foreground" Value="#444" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="Foreground" Value="#444" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.CellStyle>
                                                        <DataGrid.RowStyle>
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#EEEEEE" />
                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Foreground" Value="#444" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="White" />
                                                                        <Setter Property="Foreground" Value="#444" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="170"
                                                                                Binding="{Binding TradeDate, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                                                Header="登记日期"
                                                                                IsReadOnly="True" />
                                                            <DataGridTextColumn Width="*"
                                                                                MinWidth="260"
                                                                                Binding="{Binding DisplayReceivableRemark}"
                                                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                                                Header="应收备注"
                                                                                IsReadOnly="True" />
                                                            <DataGridTemplateColumn Width="140" Header="金额">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBox Margin="4,6"
                                                                                 Padding="2"
                                                                                 HorizontalContentAlignment="Center"
                                                                                 VerticalContentAlignment="Center"
                                                                                 BorderBrush="#CCC"
                                                                                 LostFocus="SubItem_ValueChanged"
                                                                                 Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Width="80" Header="操作">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Command="{Binding DataContext.DeleteSubItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="删除"
                                                                                Cursor="Hand"
                                                                                Foreground="#FF4D4F" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>

                                                    <Border Grid.Row="1"
                                                            Padding="12,8"
                                                            Background="#F8F9FA"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,1,0,0">
                                                        <DockPanel>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       DockPanel.Dock="Left"
                                                                       FontSize="12"
                                                                       Foreground="#888">
                                                                <Run Text="共 " />
                                                                <Run Text="{Binding CollectionTotalCount, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" />
                                                                <Run Text=" 条，每页展示 10 条" />
                                                            </TextBlock>
                                                            <StackPanel HorizontalAlignment="Right"
                                                                        DockPanel.Dock="Right"
                                                                        Orientation="Horizontal">
                                                                <Button Margin="0,0,10,0"
                                                                        Command="{Binding CollectionPrevPageCommand}"
                                                                        Content="上一页"
                                                                        IsEnabled="{Binding HasCollectionPrevPage}"
                                                                        Style="{StaticResource PageBtnStyle}" />
                                                                <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding CollectionPageNumbers}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.CollectionGoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding Page}"
                                                                                    Content="{Binding Label}">
                                                                                <Button.Style>
                                                                                    <Style BasedOn="{StaticResource PageBtnStyle}" TargetType="Button">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                                                <Setter Property="Foreground" Value="White" />
                                                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Page}" Value="0">
                                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                                                <Setter Property="BorderThickness" Value="0" />
                                                                                                <Setter Property="Background" Value="Transparent" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Command="{Binding CollectionNextPageCommand}"
                                                                        Content="下一页"
                                                                        IsEnabled="{Binding HasCollectionNextPage}"
                                                                        Style="{StaticResource PageBtnStyle}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <!--  主表的列绑定  -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" Header="">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <ToggleButton x:Name="ExpandToggle"
                                                                  Width="24"
                                                                  Height="24"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Click="OnExpandToggleClicked"
                                                                  Cursor="Hand">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent">
                                                                    <Path x:Name="Arrow"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Data="M0,0 L5,4.5 L0,9 Z"
                                                                          Fill="#666"
                                                                          RenderTransformOrigin="0.5,0.5">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                Header="公司" />
                            <DataGridTextColumn Binding="{Binding SalesmanName}"
                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                Header="业务员" />
                            <DataGridTextColumn Binding="{Binding Month}"
                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                Header="月份" />
                            <DataGridTextColumn Binding="{Binding DebtAmount, StringFormat={}{0:N2}}"
                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                Header="欠款金额 (元)" />
                            <DataGridTextColumn Binding="{Binding CollectedAmount, StringFormat={}{0:N2}}"
                                                ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                Header="已收金额 (元)" />
                            <DataGridTextColumn Binding="{Binding Balance, StringFormat={}{0:N2}}" Header="差额 (元)">
                                <DataGridTextColumn.ElementStyle>
                                    <Style BasedOn="{StaticResource CenteredGridTextStyle}" TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{Binding Balance, Converter={StaticResource BalanceColorConverter}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button Padding="2,3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.RecordDebtRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="欠款"
                                                    Cursor="Hand"
                                                    FontSize="13"
                                                    Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Margin="4,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#CCC"
                                                       Text="|" />
                                            <Button Padding="2,3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.RecordPaymentRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="收款"
                                                    Cursor="Hand"
                                                    FontSize="13"
                                                    Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!--  底部翻页栏  -->
                <Border Grid.Row="2"
                        Padding="15,12"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button Command="{Binding PrevPageCommand}"
                                    Content="上一页"
                                    IsEnabled="{Binding HasPrevPage}"
                                    Style="{StaticResource PageBtnStyle}" />
                            <ItemsControl Margin="6,0" ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Command}"
                                                CommandParameter="{Binding Page}"
                                                Content="{Binding Label}"
                                                Tag="{Binding IsCurrent}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PageBtnStyle}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="…">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding NextPageCommand}"
                                    Content="下一页"
                                    IsEnabled="{Binding HasNextPage}"
                                    Style="{StaticResource PageBtnStyle}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#666"><Run Text="共 " /><Run Text="{Binding TotalCount}" /><Run Text=" 条，展示数量： 50 条/页" /></TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
