<ui:FluentWindow x:Class="PLErpTool.Views.PersonnelEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="信息维护"
                 Width="460"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{StaticResource AppFont}"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="White"
                 WindowBackdropType="None">
    <StackPanel Margin="25">
        <Border BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="0,0,0,2"
                HorizontalAlignment="Left"
                Margin="0,0,0,20">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="#333" Padding="0,0,0,5" />
        </Border>

        <StackPanel x:Name="CustomerFields">
            <TextBlock Text="客户简称 *" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
            <ui:TextBox x:Name="CustomerShortNameInput" Padding="9,6" FontSize="13" Margin="0,0,0,15" />
            <TextBlock Text="客户全称" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
            <ui:TextBox x:Name="CustomerFullNameInput" Padding="9,6" FontSize="13" Margin="0,0,0,20" />
        </StackPanel>

        <StackPanel x:Name="SalesmanFields" Visibility="Collapsed">
            <TextBlock Text="所属客户 *" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
            <ComboBox x:Name="CustomerSelector" Height="32" DisplayMemberPath="Name" Margin="0,0,0,15" />
            <TextBlock Text="业务员姓名 *" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
            <ui:TextBox x:Name="SalesmanNameInput" Padding="9,6" FontSize="13" Margin="0,0,0,20" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Appearance="Secondary" Content="取消" Click="OnCancel" Width="76" Height="34" Margin="0,0,10,0" />
            <ui:Button x:Name="ConfirmButton" Appearance="Primary" Content="保存" Click="OnConfirm" Width="76" Height="34" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
