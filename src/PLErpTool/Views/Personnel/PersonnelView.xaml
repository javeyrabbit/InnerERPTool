<UserControl x:Class="PLErpTool.Views.Personnel.PersonnelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="White"
             FontFamily="{StaticResource AppFont}">
    <Grid Background="White" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20,16"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="人员信息维护" FontSize="18" FontWeight="SemiBold" Foreground="#333" />
                <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,14,0">
                        <TextBlock Text="客户" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
                        <ComboBox x:Name="CustomerSearchBox"
                                  Height="32"
                                  Padding="8,0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  ItemsSource="{Binding CustomerSuggestions}"
                                  Loaded="SearchComboBox_Loaded"
                                  MaxDropDownHeight="260"
                                  PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding SearchCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,18,0">
                        <TextBlock Text="业务员" FontSize="13" Foreground="#666" Margin="0,0,0,5" />
                        <ComboBox x:Name="SalesmanSearchBox"
                                  Height="32"
                                  Padding="8,0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  ItemsSource="{Binding SalesmanSuggestions}"
                                  Loaded="SearchComboBox_Loaded"
                                  MaxDropDownHeight="260"
                                  PreviewKeyUp="SearchComboBox_PreviewKeyUp"
                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding SearchSalesman, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ui:Button Content="查询" Appearance="Primary" Command="{Binding SearchCommand}" Height="34" Padding="18,0" Margin="0,20,10,0" />
                    <ui:Button Content="重置条件" Appearance="Secondary" Command="{Binding ResetSearchCommand}" Height="34" Padding="18,0" Margin="0,20,18,0" />
                    <ui:Button Content="＋ 新增客户" Appearance="Primary" Command="{Binding AddCustomerCommand}" Height="34" Padding="18,0" Margin="0,20,10,0" />
                    <ui:Button Content="＋ 新增业务员" Appearance="Primary" Command="{Binding AddSalesmanCommand}" Height="34" Padding="18,0" Margin="0,20,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="18,0">
                    <TextBlock Text="客户与业务员明细" FontSize="16" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Foreground="#666" VerticalAlignment="Center">
                        <Run Text="共 " />
                        <Run Text="{Binding PersonnelRecords.Count, Mode=OneWay}" />
                        <Run Text=" 条" />
                    </TextBlock>
                </DockPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PersonnelRecords}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          RowHeight="40"
                          ColumnHeaderHeight="40"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Resources>
                        <Style x:Key="CenteredPersonnelTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderBrush" Value="#F0F0F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFAFE" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="客户简称" Binding="{Binding CustomerShortName}" Width="*"
                                            ElementStyle="{StaticResource CenteredPersonnelTextStyle}" />
                        <DataGridTextColumn Header="业务员" Binding="{Binding SalesmanName, TargetNullValue=—}" Width="*"
                                            ElementStyle="{StaticResource CenteredPersonnelTextStyle}" />
                        <DataGridTextColumn Header="客户创建时间" Binding="{Binding CustomerCreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*"
                                            ElementStyle="{StaticResource CenteredPersonnelTextStyle}" />
                        <DataGridTextColumn Header="业务员创建时间" Binding="{Binding SalesmanCreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=—}" Width="*"
                                            ElementStyle="{StaticResource CenteredPersonnelTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
