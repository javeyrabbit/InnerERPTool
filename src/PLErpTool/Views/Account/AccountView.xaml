<UserControl x:Class="PLErpTool.Views.Account.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.Resources>
                <Style x:Key="ImportActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="#DCD8F5" />
                </Style>
            </Border.Resources>
            <StackPanel Margin="15,20">
                <TextBlock Text="数据导入" FontWeight="Bold" Foreground="#888" FontSize="13" Margin="2,0,0,10"/>
                <Button Style="{StaticResource ImportActionButtonStyle}" Content="导入源文件" Command="{Binding ImportSourceCommand}" Margin="0,0,0,12" />
                <Button Style="{StaticResource ImportActionButtonStyle}" Content="导入客户业务员关系" Command="{Binding ImportCustomerSalesmanCommand}" Margin="0,0,0,12" />
                <Button Style="{StaticResource ImportActionButtonStyle}" Content="重置导入数据" Command="{Binding ResetCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="20,20,20,10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAF9FF" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,12" CornerRadius="6,6,0,0">
                        <TextBlock Text="数据明细预览" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,12">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,6"><TextBlock Text="客户简称" FontSize="13" Foreground="#555" VerticalAlignment="Center"/><TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchCustomer, UpdateSourceTrigger=PropertyChanged}" Tag="支持模糊搜索" Width="140" Margin="8,0,0,0"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,6"><TextBlock Text="交易日" FontSize="13" Foreground="#555" VerticalAlignment="Center"/><DatePicker Width="140" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center" Language="zh-CN" SelectedDateFormat="Short" SelectedDate="{Binding SearchDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,6"><TextBlock Text="单据号码" FontSize="13" Foreground="#555" VerticalAlignment="Center"/><TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchDocumentNo, UpdateSourceTrigger=PropertyChanged}" Tag="输入单号..." Width="140" Margin="8,0,0,0"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,6"><TextBlock Text="品名" FontSize="13" Foreground="#555" VerticalAlignment="Center"/><TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchProduct, UpdateSourceTrigger=PropertyChanged}" Tag="输入品名..." Width="140" Margin="8,0,0,0"/></StackPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="查询" Command="{Binding SearchPreviewCommand}" Padding="16,7" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,12">
                        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="上一页" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Style="{StaticResource PageBtnStyle}"/><ItemsControl ItemsSource="{Binding PageNumbers}" Margin="6,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Page}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PageBtnStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding Label}" Value="…"><Setter Property="IsEnabled" Value="False"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Style="{StaticResource PageBtnStyle}"/></StackPanel><TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#666"><Run Text="共 "/><Run Text="{Binding TotalCount}"/><Run Text=" 条，展示数量： 50 条/页"/></TextBlock></DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding PreviewRecords}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeight="38" ColumnHeaderHeight="38" GridLinesVisibility="None" HeadersVisibility="Column" AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Style><Style TargetType="DataGrid"><Setter Property="ColumnWidth" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding TotalCount}" Value="0"><Setter Property="ColumnWidth" Value="*"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
                        <DataGrid.Resources><Style x:Key="CenteredGridTextStyle" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#444444"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#F0F0F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{StaticResource RowAltBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RowHoverBrush}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="客户简称" Binding="{Binding CustomerShortName}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="交易日" Binding="{Binding TradeDate}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="单据号码" Binding="{Binding DocumentNumber}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="品名" Binding="{Binding ProductName}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="头+牙+锁+管长+大管+长心" Binding="{Binding Spec}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="客户物料" Binding="{Binding CustomerMaterial}" ElementStyle="{StaticResource CenteredGridTextStyle}"/><DataGridTextColumn Header="业务员" Binding="{Binding Salesman}" ElementStyle="{StaticResource CenteredGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border x:Name="CommandOutputPanel" Grid.Row="1" Background="{StaticResource TerminalBgBrush}" Margin="20,0,20,20" CornerRadius="6" BorderBrush="#2A2540" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2A2540" Padding="12,8" CornerRadius="6,6,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#7A70D8" Margin="0,0,9,0"/><TextBlock Text="命令行输出 / Command Line Output" Foreground="#B5B5C3" FontFamily="{StaticResource TerminalFont}" FontSize="13"/></StackPanel></Border>
                    <TextBox Text="{Binding TerminalLog, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource TerminalFont}" FontSize="13" BorderThickness="0" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="12">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{StaticResource TerminalBgBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalFgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CommandOutputPanel}" Value="True">
                                        <Setter Property="Background" Value="#9B9BA3" />
                                        <Setter Property="Foreground" Value="#FAFAFC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
